/*
 * Wolfie 44-key wireless split. Right nice!nano is central, left peripheral.
 * Shared 44-position transform: logical physical rows (L then R).
 * GPIO connections and diode direction are inherited from tested standalone builds.
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    wolfie_split_kscan: wolfie_split_kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>,
                    <&gpio1 0 GPIO_ACTIVE_HIGH>,
                    <&gpio0 11 GPIO_ACTIVE_HIGH>,
                    <&gpio1 4 GPIO_ACTIVE_HIGH>,
                    <&gpio1 6 GPIO_ACTIVE_HIGH>,
                    <&gpio0 31 GPIO_ACTIVE_HIGH>;
    };

    wolfie_split_transform: wolfie_split_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>;
        map = <
            /* Physical top: left scan row3 c0..5; right row3 c5..0 */
            RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)
            /* Home */
            RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
            /* Bottom */
            RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            /* 4 left thumbs then 4 right thumbs */
            RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(0,5) RC(0,4) RC(0,3) RC(0,2)
        >;
    };

    physical_layouts {
        compatible = "zmk,physical-layouts";
        wolfie_split_layout: wolfie_split_layout {
            compatible = "zmk,physical-layout";
            display-name = "Wolfie 44-key split";
            kscan = <&wolfie_split_kscan>;
            transform = <&wolfie_split_transform>;
        };
    };
    chosen { zmk,physical-layout = &wolfie_split_layout; };
};
