#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/* Global 44-key layout, physical rows from left to right (left 6, right 6).
 * Left 4 thumbs: none, Windows, none, Space.
 * Right 4 thumbs: Enter, momentary Layer 2, AltGr, none.
 * Combined transform already reverses the physical rows / columns so the
 * bindings below are natural physical left-to-right order.
 */
/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "QWERTY";
            bindings = <
                /* TOP: left 6 then right 6 */
                &kp TAB &kp Q &kp W &kp E &kp R &kp T
                &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                /* HOME */
                &kp LSHFT &kp A &kp S &kp D &kp F &kp G
                &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
                /* BOTTOM */
                &kp LCTRL &kp Z &kp X &kp C &kp V &kp B
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC
                /* THUMBS */
                &none &kp LGUI &none &kp SPACE
                &kp RET &mo 1 &kp RALT &none
            >;
        };
        nav_layer {
            display-name = "Function";
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &kp LEFT &kp UP &kp DOWN &kp RIGHT &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };
    };
};
